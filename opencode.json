{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openrouter", "openai", "github-copilot"],
  "share": "disabled",
  "plugin": [
    "./plugins/permission-hardening.ts",
    "./plugins/altitude-context.ts",
    "./plugins/specs-state.ts",
    "./plugins/rtk-native.ts",
    "./plugins/headroom-guard.ts",
    "./plugins/context-budget.ts"
  ],
  "agent": {
    "altitude": {
      "mode": "primary",
      "description": "Harness V3 strategic coordinator for durable .specs work.",
      "max_steps": 32,
      "permission": "allow"
    },
    "altitude-intent": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal high-altitude intent capture. No source edits.",
      "max_steps": 8
    },
    "altitude-structure": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal system-altitude repo-aware structure mapping.",
      "max_steps": 18
    },
    "altitude-plan": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal planning-altitude decomposition into executable change tasks.",
      "max_steps": 24
    },
    "altitude-execution": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal low-altitude execution. One approved task at a time.",
      "max_steps": 40
    },
    "altitude-validation": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal validation altitude. Checks evidence, tests, scope, and acceptance criteria.",
      "max_steps": 20
    },
    "altitude-report": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal report altitude. Generates executive and technical summaries from .specs artifacts.",
      "max_steps": 16
    },
    "altitude-memory": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal memory altitude. Updates .specs/memory, archive, and active state.",
      "max_steps": 12
    },
    "data-engineer": {
      "mode": "primary",
      "description": "Harness V3 tactical coordinator for bounded data-engineering work.",
      "max_steps": 32,
      "permission": "allow"
    },
    "data-engineering.spark-engineer": { "disable": true },
    "data-engineering.spark-performance-analyzer": { "disable": true },
    "data-engineering.spark-streaming-architect": { "disable": true },
    "data-engineering.lakeflow-architect": { "disable": true },
    "data-engineering.lakeflow-expert": { "disable": true },
    "python.ai-prompt-specialist": { "disable": true },
    "dev.prompt-crafter": { "disable": true },
    "cloud.ai-prompt-specialist-gcp": { "disable": true },
    "cloud.supabase-specialist": { "disable": true },
    "platform.fabric-ai-specialist": { "disable": true },
    "platform.fabric-cicd-specialist": { "disable": true },
    "platform.fabric-logging-specialist": { "disable": true },
    "cloud.aws-deployer": { "disable": true },
    "cloud.lambda-builder": { "disable": true },
    "cloud.ai-data-engineer-gcp": { "disable": true },
    "cloud.ai-data-engineer-cloud": { "disable": true }
  }
}
