{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openrouter", "openai", "github-copilot"],
  "share": "disabled",
  "instructions": [
    ".specs/changes/harness-skill-based-migration/staged/AGENTS.next.md"
  ],
  "permission": {
    "*": "allow",
    "bash": "allow",
    "read": {
      "*": "allow",
      "*.env": "allow",
      "*.env.*": "allow",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "question": "allow",
    "doom_loop": "allow",
    "plan_enter": "allow",
    "plan_exit": "allow",
    "skill": {
      "*": "allow",
      "visual-explainer": "allow",
      "workflow-commands": "allow",
      "task-spec": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@context7/mcp-server"],
      "enabled": false,
      "env": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@openai/agent-memory-server"],
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve"],
      "enabled": false
    },
    "headroom": {
      "type": "local",
      "command": ["echo", "headroom-handled-by-plugin"],
      "enabled": false
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
