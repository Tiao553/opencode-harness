{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openrouter", "openai", "github-copilot"],
  "share": "disabled",
  "plugin": [
    "./plugins/permission-hardening.ts",
    "./plugins/altitude-context.ts",
    "./plugins/specs-state.ts",
    "./plugins/rtk-native.ts",
    "./plugins/headroom-guard.ts",
    "./plugins/context-budget.ts",
    "./plugins/altitude-filestore.ts"
  ],
  "headroom": {
    "budget_total_kb": 100,
    "budget_warn_percent": 20,
    "budget_critical_percent": 10,
    "budget_block_percent": 5,
    "compression": {
      "enable_rtk": true,
      "enable_lossy": true,
      "target_compression_ratio": 0.8,
      "defer_threshold_kb": 15
    },
    "phase_budgets": {
      "intent": 25,
      "structure": 30,
      "plan": 40,
      "execution": 50,
      "validation": 40,
      "report": 35,
      "memory": 20
    }
  },
  "agent": {
    "altitude-maestro": {
      "mode": "primary",
      "description": "Unified Harness V3 coordinator",
      "max_steps": 32,
      "permission": "allow"
    },
    "altitude-intent": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal high-altitude intent capture. No source edits.",
      "max_steps": 8
    },
    "altitude-structure": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal system-altitude repo-aware structure mapping.",
      "max_steps": 18
    },
    "altitude-plan": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal planning-altitude decomposition into executable change tasks.",
      "max_steps": 24
    },
    "altitude-execution": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal low-altitude execution. One approved task at a time.",
      "max_steps": 40
    },
    "altitude-validation": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal validation altitude. Checks evidence, tests, scope, and acceptance criteria.",
      "max_steps": 20
    },
    "altitude-report": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal report altitude. Generates executive and technical summaries from .specs artifacts.",
      "max_steps": 16
    },
    "altitude-memory": {
      "mode": "subagent",
      "hidden": true,
      "description": "Internal memory altitude. Updates .specs/memory, archive, and active state.",
      "max_steps": 12
    },
    "data-engineer": {
      "mode": "primary",
      "description": "Harness V3 tactical coordinator for bounded data-engineering work.",
      "max_steps": 32,
      "permission": "allow"
    }
  }
}
