{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "graph-router",

  "plugin": [
    "@cafeng/openrtk",
    "./tools/graphify.js"
  ],

  "permission": "allow",

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },

    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"]
    },

    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/ubuntu"
      ]
    },

    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },

    "graphcode": {
      "type": "local",
      "command": ["npx", "-y", "@levnikolaevich/hex-graph-mcp"]
    }
  }
}
