{
  "skill": "review-commands",
  "priority": "medium",
  "commands": {
    "/review:review": {
      "file": "commands/review:review.md",
      "agent": "~/.config/opencode/agents/python.code-reviewer.agent.md",
      "kb": [],
      "input": "File or directory to review",
      "output": "Review findings ordered by severity"
    },
    "/review:judge": {
      "file": "commands/review:judge.md",
      "agent": "~/.config/opencode/agents/dev.judge-agent.agent.md",
      "kb": [],
      "input": "File to judge + optional context and model",
      "output": "External verdict + ledger entry in ~/.config/opencode/storage/judge-ledger.jsonl"
    }
  },
  "conditions": [
    "User invokes /review-commands",
    "Code review or quality assessment requested",
    "Judge second-opinion or ledger query"
  ],
  "dependencies": [
    "~/.config/opencode/config/routing.json"
  ],
  "optional_policy_references": [
    "~/.config/opencode/config/grounding.md"
  ]
}
