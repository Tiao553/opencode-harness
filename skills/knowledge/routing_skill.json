{
  "skill": "knowledge-commands",
  "priority": "medium",
  "commands": {
    "/knowledge:create-kb": {
      "file": "commands/knowledge:create-kb.md",
      "agent": "~/.config/opencode/agents/architect.kb-architect.agent.md",
      "kb": ["_templates"],
      "input": "Domain name and optional source/topics",
      "output": "~/.config/opencode/kb/{domain}/ with index.md, quick-reference.md, concepts/, patterns/, specs/"
    },
    "/knowledge:update-kb": {
      "file": "commands/knowledge:update-kb.md",
      "agent": "~/.config/opencode/agents/architect.kb-architect.agent.md",
      "kb": ["_templates"],
      "input": "Domain name and optional topic/source/since filters",
      "output": "Updated KB files with refreshed MCP validation dates"
    },
    "/knowledge:refresh-stale-kbs": {
      "file": "commands/knowledge:refresh-stale-kbs.md",
      "agent": "~/.config/opencode/agents/architect.kb-architect.agent.md",
      "kb": ["_templates"],
      "input": "Optional max-age parameter",
      "output": "Audit report + updated stale KB domains"
    }
  },
  "conditions": [
    "User invokes /knowledge-commands",
    "KB creation, update, or audit requested",
    "Knowledge base domain referenced"
  ],
  "dependencies": [
    "~/.config/opencode/config/routing.json",
    "~/.config/opencode/kb/_index.yaml",
    "~/.config/opencode/kb/_templates/"
  ],
  "optional_policy_references": [
    "~/.config/opencode/config/grounding.md"
  ]
}
