# Privacy-first: ignore everything by default.
# Explicitly allow only reusable framework files.
*

# Keep directory traversal working for allowed paths below.
!*/

# Repository metadata and docs.
!.gitignore
!.pre-commit-config.yaml
!.markdownlint-cli2.jsonc
!AGENTS.md
!README.md
!opencode.json
!opencode.jsonc
!.specs/
!.specs/README.md
!.specs/shared/
!.specs/shared/**
!.specs/templates/
!.specs/templates/**
!docs/
!docs/**

# Shareable opencode framework files.
!agents/
!agents/**
!commands/
!commands/**
!config/
!config/**
!kb/
!kb/**
!skills/
!skills/
!skills/**
!tools/
!tools/**
!plugins/
!plugins/**
!test/
!test/fixtures/
!test/fixtures/**

# Keep only canonical SDD docs and templates versionable.
!sdd/
!sdd/README.md
!sdd/_index.md
!sdd/architecture/
!sdd/architecture/**
!sdd/templates/
!sdd/templates/**

# Ignore local runtime, memory, generated outputs, and user context.
node_modules/
storage/
knowledge_context/
.specs/changes/
.specs/memory/
.specs/archive/
.specs/reports/
sdd/features/
sdd/archive/
sdd/reports/

# Ignore local package management files in this config workspace.
package.json
package-lock.json
bun.lock

# Ignore secrets, local overrides, logs, and editor/system noise.
.env
.env.*
*.local
*.log
*.tmp
*.swp
*.swo
.DS_Store
